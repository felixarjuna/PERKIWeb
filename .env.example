# Copy this file to ".env" for local development. It is committed, so it must
# never contain real secrets. When adding a variable, also add it to the schema
# and `runtimeEnv` in "src/env.mjs".

# Local dev database from compose.dev.yml (`pnpm db:dev`). Never point local
# development at production: prod's schema changes only through CI on `main`.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54320/perkiweb_dev"

# Auth.js. Generate a secret with `openssl rand -base64 32`.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client with http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_API_KEY=""

# Optional: perki.bot status URL (defaults to https://perki-bot.fly.dev).
# PERKI_BOT_URL=""

# Optional: shared Google Drive folder link, shown to staff in the admin sidebar.
# DRIVE_FOLDER_URL=""
