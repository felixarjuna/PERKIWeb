{
  "name": "perkiweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:dev": "docker compose -f compose.dev.yml up -d --wait",
    "db:dev:down": "docker compose -f compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx ./src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "roles": "npx tsx scripts/roles.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "screenshots:publish": "node scripts/pr-screenshots.ts",
    "start": "next start",
    "takeaways:markdown-check": "npx tsx scripts/takeaway-markdown-check.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:db": "docker compose -f compose.test.yml up -d --wait",
    "test:e2e:db:down": "docker compose -f compose.test.yml down",
    "test:integration": "vitest run --project server",
    "test:unit": "vitest run --project unit --project dom",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
